<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Version>0.4.0</Version>
    <PackageId>BlackThunder.UniTest</PackageId>
    <Authors>dove-creative</Authors>
    <Description>A model-based .NET testing framework that generates and verifies executable state-action paths.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/dove-creative/unitest</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dove-creative/unitest</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
